# ================= Gym Manager MySQL =================
DATABASE_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/multiagent_gym?charset=utf8mb4

# ================= Application =================
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_HOURS=24
AUTO_CREATE_TABLES=true
SEED_DEMO_DATA=false
ALLOW_LEGACY_PLAINTEXT_PASSWORDS=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ================= Main Agent =================
AGENT_PROVIDER=ark
AGENT_MODEL=deepseek-v4-flash-ga-260731
AGENT_TEMPERATURE=0.3
AGENT_MAX_TOKENS=1600
AGENT_TIMEOUT_SECONDS=60
AGENT_MAX_TOOL_ROUNDS=4
AGENT_KNOWLEDGE_TOP_K=5
AGENT_KNOWLEDGE_FILE=data/健身知识大全_核心版_v0.5.md

# ================= Milvus Hybrid Retrieval =================
RAG_ENABLED=true
RAG_REQUIRED=false
RAG_AUTO_INDEX=true
RAG_MILVUS_URI=http://your-milvus-host:19530
RAG_MILVUS_TOKEN=username:password
RAG_COLLECTION=gym_knowledge_v1
RAG_DENSE_DIMENSIONS=1024
RAG_CANDIDATE_LIMIT=20
RAG_DENSE_WEIGHT=0.4
RAG_KEYWORD_WEIGHT=0.6
RAG_EMBEDDING_CONCURRENCY=3
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EMBEDDING_MODEL=doubao-embedding-vision-251215
EMBEDDING_TIMEOUT_SECONDS=60

WAITLIST_OFFER_MINUTES=15
CHECKIN_TOKEN_SECONDS=45
CHECKIN_OPEN_MINUTES_BEFORE=30
CHECKIN_CLOSE_MINUTES_AFTER=15
NO_SHOW_GRACE_MINUTES=30
NO_SHOW_LOOKBACK_DAYS=2
NO_SHOW_AUTO_ENABLED=true
MAINTENANCE_INTERVAL_SECONDS=60
FRONTEND_PUBLIC_URL=http://127.0.0.1:9000

# 默认使用火山方舟；也可以在 AGENT_PROVIDER 中选择 zhipu、dashscope、
# deepseek、openai、openrouter 或 siliconflow。
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
